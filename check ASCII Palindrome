#include <string>
#include <bitset>

class Solution {
public:
    bool isPalindromic(std::string s) { // Renamed to match LeetCode's template
        std::string binaryStr = "";
        
        // 1. Construct the 8-bit binary representation of each character
        for (char c : s) {
            binaryStr += std::bitset<8>(c).to_string();
        }
        
        // 2. Check if the binary string is a palindrome
        int left = 0;
        int right = binaryStr.length() - 1;
        
        while (left < right) {
            if (binaryStr[left] != binaryStr[right]) {
                return false;
            }
            left++;
            right--;
        }
        
        return true;
    }
};
