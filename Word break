#include <string>
#include <vector>
#include <unordered_set>

class Solution {
public:
    bool wordBreak(std::string s, std::vector<std::string>& wordDict) {
        // Convert vector to an unordered_set for O(1) lookups
        std::unordered_set<std::string> wordSet(wordDict.begin(), wordDict.end());
        int n = s.length();
        
        // dp[i] means s[0...i-1] can be segmented into dictionary words
        std::vector<bool> dp(n + 1, false);
        dp[0] = true; // Base case: empty string
        
        // Outer loop defines the end of the current substring
        for (int i = 1; i <= n; ++i) {
            // Inner loop defines the split point
            for (int j = 0; j < i; ++j) {
                // If the prefix s[0...j-1] is valid AND the remaining substring is in the dict
                if (dp[j] && wordSet.count(s.substr(j, i - j))) {
                    dp[i] = true;
                    break; // Found a valid match for position i, move to next i
                }
            }
        }
        
        return dp[n];
    }
};
