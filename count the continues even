#include <stdio.h>
int main() {
    int n;
    if (scanf("%d", &n) != 1)
        return 1;
    int arr[n];
    int max = 0;
    int c = 0;
    for (int i = 0; i < n; i++) {
        scanf("%d", &arr[i]);
        if (arr[i] % 2 == 0) {
            c++;
            if (c > max) {
                max = c;
            }
        } else {
            c = 0; 
        }
    }
    printf("%d\n", max);
    return 0;
}
