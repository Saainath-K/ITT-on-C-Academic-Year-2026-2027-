class Solution {
public:
    ListNode* addTwoNumbers(ListNode* l1, ListNode* l2) {
        ListNode* head = nullptr;
        ListNode** ppNode = &head; // Pointer to pointer to track the next insertion site
        int carry = 0;
        
        while (l1 != nullptr || l2 != nullptr || carry != 0) {
            int sum = carry;
            
            if (l1 != nullptr) {
                sum += l1->val;
                l1 = l1->next;
            }
            if (l2 != nullptr) {
                sum += l2->val;
                l2 = l2->next;
            }
            
            carry = sum / 10;
            
            // Allocate the new node directly into the target slot
            *ppNode = new ListNode(sum % 10);
            ppNode = &((*ppNode)->next); // Move pointer to the next slot
        }
        
        return head;
    }
};
