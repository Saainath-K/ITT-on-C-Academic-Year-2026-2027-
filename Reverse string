#include <vector>
#include <utility>

class Solution {
public:
    void reverseString(std::vector<char>& s) {
        int left = 0;
        int right = s.size() - 1;
        
        while (left < right) {
            // Swap characters at the boundary pointers
            std::swap(s[left], s[right]);
            
            // Move pointers inward towards the center
            left++;
            right--;
        }
    }
};
