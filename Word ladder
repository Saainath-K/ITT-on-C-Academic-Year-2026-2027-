#include <string>
#include <vector>
#include <unordered_set>
#include <queue>

class Solution {
public:
    int ladderLength(std::string beginWord, std::string endWord, std::vector<std::string>& wordList) {
        // Transfer words to an unordered_set for O(1) lookups
        std::unordered_set<std::string> wordSet(wordList.begin(), wordList.end());
        
        // If the target word is not in the dictionary, no valid path exists
        if (wordSet.find(endWord) == wordSet.end()) return 0;
        
        // Queue stores pairs of {current_word, current_path_length}
        std::queue<std::pair<std::string, int>> q;
        q.push({beginWord, 1});
        
        while (!q.empty()) {
            auto [word, level] = q.front();
            q.pop();
            
            // Target found, return the total word count in the sequence
            if (word == endWord) return level;
            
            // Try mutating every character position of the current word
            for (int i = 0; i < word.length(); ++i) {
                char originalChar = word[i];
                
                for (char c = 'a'; c <= 'z'; ++c) {
                    if (c == originalChar) continue;
                    
                    word[i] = c;
                    
                    // If the mutated word exists in the dictionary
                    if (wordSet.find(word) != wordSet.end()) {
                        q.push({word, level + 1});
                        wordSet.erase(word); // Erase acts as a "visited" marker
                    }
                }
                // Restore character for the next position loop
                word[i] = originalChar;
            }
        }
        
        return 0; // No valid transformations found
    }
};
