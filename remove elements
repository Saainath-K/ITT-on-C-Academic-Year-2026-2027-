#include <vector>

class Solution {
public:
    int removeElement(std::vector<int>& nums, int val) {
        int k = 0; // Tracks the position to write the next element not equal to val
        
        for (int i = 0; i < nums.size(); ++i) {
            // If the current element is not the target value, preserve it
            if (nums[i] != val) {
                nums[k] = nums[i];
                k++;
            }
        }
        
        return k; // k represents the count of elements not equal to val
    }
};
