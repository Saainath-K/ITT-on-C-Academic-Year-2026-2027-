#include <vector>
#include <utility>

class Solution {
public:
    void moveZeroes(std::vector<int>& nums) {
        int lastNonZeroFoundAt = 0; // Tracks where the next non-zero element goes
        
        for (int i = 0; i < nums.size(); ++i) {
            // When we find a non-zero element, swap it with the element at our target index
            if (nums[i] != 0) {
                std::swap(nums[lastNonZeroFoundAt], nums[i]);
                lastNonZeroFoundAt++;
            }
        }
    }
};
