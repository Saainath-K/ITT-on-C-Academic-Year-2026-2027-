class Solution {
public:
    int longestAlternatingSubarray(vector<int>& v, int k) {
        int ans = 0;
        for(int i = 0;i < v.size();i++){
            int ct = 0;
            if((v[i] % 2 == 0) && (v[i] <= k)){
                ct = 1;
                for(int j = i + 1;j < v.size();j++){
                    if((v[j] % 2 == v[j - 1] % 2) || v[j] > k) break;
                    ct++;
                }
            }
            
            ans = max(ans,ct);
        }
        return ans;
    }
};
